{
  "name": "fictional-cartographer",
  "version": "0.0.1",
  "description": "Project Kaki（Project 垣）：Obsidian 六边形客制化地图创作插件",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "build:esbuild": "node esbuild.config.mjs production",
    "test": "node --test --test-isolation=none",
    "test:list": "node --test --test-isolation=none --test-reporter=tap",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "node scripts/deploy.mjs",
    "check": "node scripts/build.mjs && npm run test && node scripts/smoke.mjs && node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  }
}
